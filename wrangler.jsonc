{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ilovemoovie-quiz-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-02",
  "observability": { "enabled": true },
  "vars": {
    "ADMIN_IDS": "323262204",
    "CHANNEL_ID": "@ilovemoovie",
    "CHANNEL_USERNAME": "ilovemoovie",
    "BOT_USERNAME": "Ilovemoovie_bot",
    "QUIZ_HOURS": "48",
    "SESSION_MINUTES": "20"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ilovemoovie-quiz-db",
      "database_id": "876221ca-a99e-40cf-ad95-a05370a13a6c",
      "migrations_dir": "migrations"
    }
  ]
}
