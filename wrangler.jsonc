{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ilovemoovie-quiz-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-02",
  "observability": { "enabled": true },
  "vars": {
    "ADMIN_IDS": "323262204",
    "CHANNEL_ID": "-1004402345621",
    "BOT_USERNAME": "Ilovemoovie_bot",
    "QUIZ_HOURS": "48",
    "WEBHOOK_URL": "https://ilovemoovie-quiz-bot.spectran186.workers.dev/telegram/webhook"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ilovemoovie-quiz-db",
      "database_id": "876221ca-a99e-40cf-ad95-a05370a13a6c",
      "migrations_dir": "migrations"
    }
  ]
}
